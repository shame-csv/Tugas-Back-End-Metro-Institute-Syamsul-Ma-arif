<?php

$dataMahasiswa = [
    "Andi" => 83,
    "Budi" => 78,
    "Citra" => 70,
    "Dewi" => 67,
    "Eko" => 55
];

function tentukanGrade($nilai) {
    if ($nilai >= 80) {
        return "A";
    } elseif ($nilai >= 75) {
        return "B";
    } elseif ($nilai >= 70) {
        return "C";
    } elseif ($nilai >= 65) {
        return "D";
    } elseif ($nilai < 65) {
        return "E";
    }
            
}

foreach ($dataMahasiswa as $nama => $nilai) {
    $grade = tentukanGrade($nilai);
    echo "Nama :" . $nama . "\n";
    echo "Nilai :" . $nilai . "\n";
    echo "Grade :" . $grade . "\n";
} 
